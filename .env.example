# Database connection (PostgreSQL 15)
DATABASE_URL="postgresql://scribe_user:scribe_password@localhost:5432/scribehealth_db"

# Object Storage (S3-compatible: MinIO locally, Cloudflare R2 / AWS S3 in prod)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="scribehealth-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"

# AI Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
OLLAMA_BASE_URL="http://localhost:11434"
AI_VENDOR="gemini" # Allowed values: 'gemini' | 'ollama' | 'none'
